// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  isActive    Boolean  @default(true)
  email       String   @unique
  phoneNumber String
  password    String
  profileImage String? // URL รูปโปรไฟล์ (MinIO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Social Login Integration
  lineUserId     String? @unique // LINE userId จาก LINE Login OAuth
  googleUserId   String? @unique // Google sub จาก Google OAuth
  facebookUserId String? @unique // Facebook user ID จาก Facebook Login OAuth

  // Password Reset
  passwordResetToken     String?   @unique // Token สำหรับรีเซ็ตรหัสผ่าน
  passwordResetExpiresAt DateTime? // วันหมดอายุของ reset token

  // Delete Account verification (6-digit code sent to email)
  deleteAccountCode          String?   // 6-digit code (hashed)
  deleteAccountCodeExpiresAt DateTime? // วันหมดอายุของ code

  // Package
  currentPackageId String?
  currentPackage   Package?  @relation("UserCurrentPackage", fields: [currentPackageId], references: [id])
  packageExpiresAt DateTime?
  bonusListingSlots Int      @default(0) // slot เพิ่มจากการซื้อเพิ่ม (ถาวร นอกเหนือจาก package)

  // Relations
  listings            VehicleListing[]
  wishlists           Wishlist[]
  packageTransactions PackageTransaction[]
  listingRenewals     ListingRenewal[]
  bumpLogs            ListingBumpLog[]
  notifications       UserNotification[]
  pushSubscriptions   PushSubscription[]
  kycSubmissions      KycSubmission[]
  abuseReports        AbuseReport[]
  garageVehicles      GarageVehicle[]
  inspectionBookings  InspectionBooking[]
  serviceInquiries    ServiceInquiry[]
  slotPurchases       SlotPurchase[]

  // Forum relations
  forumPosts          ForumPost[]
  forumComments       ForumComment[]
  forumVotes          ForumVote[]
  forumCommentVotes   ForumCommentVote[]
  reputation          UserReputation?

  // Seller Profile
  sellerProfile       SellerProfile?

  @@index([currentPackageId])
  @@index([lineUserId])
  @@index([googleUserId])
  @@index([facebookUserId])
  @@map("users")
}

// =============================================
// Seller Profile - โปรไฟล์ร้านค้า/ผู้ขาย
// =============================================

enum ShowroomType {
  INDIVIDUAL // บุคคลธรรมดา (KYC type = INDIVIDUAL)
  CORPORATE  // นิติบุคคล — ร้าน/เต๊นท์/ดีลเลอร์/บริษัท (KYC type = CORPORATE)
}

model SellerProfile {
  id                  String       @id @default(cuid())
  shopName            String       // ชื่อร้าน เช่น "เต๊นเฮียชัย นนทบุรี"
  shopDescription     String?      @db.Text
  shopLogo            String?      // MinIO URL
  shopCoverImage      String?      // MinIO URL
  shopAddress         String?
  shopProvince        String?
  shopDistrict        String?
  shopMapUrl          String?      // Google Maps link
  shopPhone           String?
  showroomType        ShowroomType @default(INDIVIDUAL)
  shopOpenHours       String?      // "จ-ส 09:00-18:00"
  shopEstablishedYear Int?
  socialWebsite       String?
  socialFacebook      String?
  socialLine          String?
  socialInstagram     String?
  specializations     Json         @default("[]") // ["รถยุโรป", "Big Bike"]
  totalSoldCount      Int          @default(0)
  isVerified          Boolean      @default(false)
  verifiedAt          DateTime?
  // KYC trust level — orthogonal to Package tier
  // NONE = ยังไม่ยืนยัน, INDIVIDUAL = ยืนยันบุคคลธรรมดา, CORPORATE = ยืนยันนิติบุคคล
  verificationLevel   String       @default("NONE")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopProvince])
  @@index([verificationLevel])
  @@map("seller_profiles")
}

// KYC (Know Your Customer) submission — รองรับ 2 ระดับ INDIVIDUAL / CORPORATE
// ผู้ใช้ submit เอกสาร → admin review → approve/reject → badge + verificationLevel
model KycSubmission {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String        // INDIVIDUAL | CORPORATE
  status String        @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED

  // ─── Personal identity (required for every submission) ───
  fullName     String?
  idNumber     String?  // เลขบัตรประชาชน (plain — admin-only read; consider encrypting at rest)
  idCardImage  String?  // MinIO URL — รูปบัตร ปชช.
  selfieImage  String?  // รูปเซลฟี่ถือบัตร (เฉพาะ INDIVIDUAL)

  // ─── Corporate (type = CORPORATE) ───
  businessName         String?
  taxId                String?  // เลขผู้เสียภาษี
  businessCertImage    String?  // ใบทะเบียนพาณิชย์ / หนังสือรับรองบริษัท
  addressProofImage    String?  // DEPRECATED — เหลือไว้ backward compat
  dealerAppointmentDoc String?  // DEPRECATED — เหลือไว้ backward compat

  requestedShowroom  ShowroomType?  // ถ้าขอเปลี่ยน showroomType

  // ─── Review metadata ───
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?   // admin id (FK to admins table, not enforced)
  reviewNote  String?   @db.Text  // เหตุผลถ้า reject / note ถ้า approve

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("kyc_submissions")
}

// =============================================
// Admin - ผู้ดูแลระบบ
// =============================================
model Admin {
  id        String   @id @default(cuid())
  fullName  String
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  articles Article[]

  @@map("admins")
}

// =============================================
// Articles - บทความให้ความรู้
// =============================================
model Article {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  content       String     @db.Text
  excerpt       String?    @db.Text
  featuredImage String?
  status        PostStatus @default(DRAFT)
  viewCount     Int        @default(0)
  isFeatured    Boolean    @default(false)
  tags          String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  authorId   String
  author     Admin            @relation(fields: [authorId], references: [id])
  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("articles")
}

model ArticleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  articles Article[]

  @@map("article_categories")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// Wishlist - รายการโปรดของผู้ใช้
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  // Relations
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("wishlists")
}

// =============================================
// Master Data - ข้อมูลหลัก ยี่ห้อ รุ่น รุ่นย่อย
// =============================================

// ยี่ห้อ
model Brand {
  id          String      @id @default(cuid())
  name        String // ชื่อยี่ห้อ เช่น Toyota, Honda, BMW
  nameTh      String? // ชื่อภาษาไทย
  logo        String? // URL โลโก้
  vehicleType VehicleType // CAR หรือ MOTORCYCLE
  country     String? // ประเทศผู้ผลิต
  isPopular   Boolean     @default(false) // ยี่ห้อยอดนิยม
  isActive    Boolean     @default(true)
  order       Int         @default(0) // ลำดับการแสดง
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  models VehicleModel[]

  @@unique([name, vehicleType])
  @@index([vehicleType])
  @@index([isPopular])
  @@map("brands")
}

// รุ่น
model VehicleModel {
  id        String    @id @default(cuid())
  name      String // ชื่อรุ่น เช่น Camry, Civic, CBR150R
  nameTh    String? // ชื่อภาษาไทย
  bodyType  BodyType? // ประเภทตัวถัง
  yearStart Int? // ปีเริ่มผลิต
  yearEnd   Int? // ปีสิ้นสุด (null = ยังผลิตอยู่)
  isPopular Boolean   @default(false)
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  brandId   String
  brand     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  subModels VehicleSubModel[]

  @@unique([brandId, name])
  @@index([brandId])
  @@index([isPopular])
  @@map("vehicle_models")
}

// รุ่นย่อย
model VehicleSubModel {
  id           String        @id @default(cuid())
  name         String // ชื่อรุ่นย่อย เช่น 2.0 Turbo RS, G Edition
  engineSize   Int? // ขนาดเครื่อง (cc)
  fuelType     FuelType? // ประเภทเชื้อเพลิง
  transmission Transmission? // ระบบเกียร์
  seats        Int? // จำนวนที่นั่ง
  yearStart    Int? // ปีเริ่มผลิต
  yearEnd      Int? // ปีสิ้นสุด
  isActive     Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  modelId String
  model   VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, name])
  @@index([modelId])
  @@map("vehicle_sub_models")
}

// =============================================
// Vehicle Listing - ข้อมูลประกาศขายยานพาหนะ (รถยนต์/มอเตอร์ไซค์)
// =============================================
model VehicleListing {
  id String @id @default(cuid())

  // ประเภทยานพาหนะ
  vehicleType VehicleType // รถยนต์หรือมอเตอร์ไซค์

  // ข้อมูลพื้นฐาน
  title       String // หัวข้อประกาศ เช่น "Honda Civic 2020 สภาพดีมาก"
  description String? @db.Text // รายละเอียดเพิ่มเติม
  price       Decimal @db.Decimal(12, 2) // ราคา (รองรับถึง 9,999,999,999.99)

  // ข้อมูลยานพาหนะ
  brand    String // ยี่ห้อ เช่น Toyota, Honda, BMW, Kawasaki, Yamaha
  model    String // รุ่น เช่น Camry, Civic, CBR150R, NMAX
  subModel String? // รุ่นย่อย/แพ็คเกจ เช่น 2.0 Turbo RS, ABS Edition
  year     Int // ปี (ค.ศ.) เช่น 2020
  color    String // สี เช่น ขาว, ดำ, เงิน

  // ข้อมูลเครื่องยนต์และการขับขี่
  fuelType     FuelType? // ประเภทเชื้อเพลิง (optional)
  transmission Transmission? // ระบบเกียร์ (optional สำหรับมอเตอร์ไซค์บางรุ่น)
  engineSize   Int? // ขนาดเครื่อง (cc) เช่น 150, 300, 1800, 2000
  seats        Int? // จำนวนที่นั่ง
  mileage      Int? // เลขไมล์ (กม.) — null = ผู้ขายเลือก "ไม่ระบุ"

  // ประเภทตัวถัง
  bodyType BodyType // ประเภทตัวถัง (รถยนต์หรือมอเตอร์ไซค์)

  // ข้อมูลทะเบียนและเอกสาร
  plateProvince    String? // จังหวัดป้ายทะเบียน
  registrationType RegistrationType @default(PERSONAL) // ประเภทการจดทะเบียน

  // สภาพยานพาหนะ
  condition   Condition // สภาพโดยรวม
  hasAccident Boolean   @default(false) // เคยมีอุบัติเหตุหรือไม่
  hasModified Boolean   @default(false) // มีการตกแต่ง/โมดิฟายหรือไม่
  hasWarranty Boolean   @default(false) // มีประกัน/warranty เหลือ

  // ที่ตั้ง
  province String? // จังหวัด — optional (ผู้ขายไม่เลือกก็ได้)
  district String? // อำเภอ/เขต

  // ข้อมูลติดต่อผู้ขาย
  contactName  String? // ชื่อผู้ติดต่อ
  contactPhone String? // เบอร์โทรติดต่อ
  lineId       String? // LINE ID
  facebookUrl  String? // Facebook URL หรือ Username

  // ข้อมูลเพิ่มเติมช่วยตัดสินใจ
  taxPaid                Boolean                @default(false) // พรบ และ ภาษีครบ
  registrationBookStatus RegistrationBookStatus @default(READY) // สถานะเล่มทะเบียน
  insuranceDetails       String? // รายละเอียดประกัน (ถ้ามีค่า = มีประกัน)
  warrantyDetails        String? // รายละเอียด warranty (ถ้ามีค่า = มี warranty)
  bsiDetails             String? // รายละเอียด BSI (ถ้ามีค่า = มี BSI)
  gasType                GasType                @default(NONE) // ติดแก๊สหรือไม่
  hasSpareKey            Boolean                @default(false) // มีกุญแจสำรอง
  serviceHistoryImage    String? // รูปภาพประวัติบริการ (ถ้ามี = มีประวัติ)
  registrationBookImage  String? // สำเนาเล่มทะเบียนรถ

  // สถานะประกาศ
  status     ListingStatus @default(ACTIVE)
  adminNote  String?       // หมายเหตุจาก admin (เช่น เหตุผลที่ปฏิเสธ)
  isFeatured Boolean       @default(false) // ประกาศแนะนำ
  isPremium  Boolean       @default(false) // ประกาศพรีเมียม

  // สถิติ
  viewCount     Int @default(0) // จำนวนคนดู
  contactCount  Int @default(0) // จำนวนคนติดต่อ
  favoriteCount Int @default(0) // จำนวนคนบันทึก

  // วันที่
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime? // วันที่เผยแพร่ (ACTIVE จริง)
  expiredAt    DateTime? // วันหมดอายุประกาศ
  bumpedAt     DateTime? // วันที่ดันโพสล่าสุด (ใช้เรียงลำดับ)
  autoBumpSlot Int?      // slot ดันโพสอัตโนมัติ (0-based) ถ้า null = ระบบจัดให้
  pausedAt     DateTime? // วันที่ถูก pause (เก็บสำหรับเรียงลำดับ unpause FIFO)
  remainingDays Int?     // จำนวนวันที่เหลือตอน pause (freeze ไว้) นับต่อเมื่อ active อีกครั้ง

  // Relations
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    VehicleImage[]
  wishlists Wishlist[]
  renewals  ListingRenewal[]
  bumpLogs  ListingBumpLog[]
  forumPosts ForumPost[]

  @@index([vehicleType])
  @@index([brand, model])
  @@index([price])
  @@index([province])
  @@index([status])
  @@index([createdAt])
  @@index([bumpedAt])
  @@map("vehicle_listings")
}

// =============================================
// Vehicle Image - รูปภาพยานพาหนะ
// =============================================
model VehicleImage {
  id        String   @id @default(cuid())
  url       String // URL รูปภาพ
  publicId  String? // Public ID สำหรับ Cloudinary/S3
  isPrimary Boolean  @default(false) // รูปหลัก (thumbnail)
  order     Int      @default(0) // ลำดับการแสดง
  createdAt DateTime @default(now())

  // Relations
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("vehicle_images")
}

// =============================================
// Enums
// =============================================

// ประเภทยานพาหนะ
enum VehicleType {
  CAR // รถยนต์
  MOTORCYCLE // มอเตอร์ไซค์
}

// ประเภทเชื้อเพลิง
enum FuelType {
  PETROL // เบนซิน
  DIESEL // ดีเซล
  HYBRID // ไฮบริด
  PLUGIN_HYBRID // ปลั๊กอินไฮบริด
  EV // ไฟฟ้า
  LPG // แก๊ส LPG
  NGV // แก๊ส NGV
}

// ระบบเกียร์
enum Transmission {
  AUTOMATIC // อัตโนมัติ
  MANUAL // ธรรมดา
  CVT // CVT
  DCT // DCT (เกียร์คลัตช์คู่)
  SEMI_AUTO // กึ่งอัตโนมัติ (สำหรับมอเตอร์ไซค์)
}

// ประเภทตัวถัง
enum BodyType {
  // === รถยนต์ ===
  SEDAN // รถเก๋ง
  HATCHBACK // แฮทช์แบ็ก
  SUV // SUV
  CROSSOVER // ครอสโอเวอร์
  MPV // MPV/รถครอบครัว
  PICKUP // กระบะ
  COUPE // คูเป้
  CONVERTIBLE // เปิดประทุน
  WAGON // แวกอน
  VAN // รถตู้

  // === มอเตอร์ไซค์ ===
  STANDARD // มอเตอร์ไซค์ทั่วไป
  SCOOTER // สกู๊ตเตอร์/ออโตเมติก
  SPORT // สปอร์ต
  NAKED // เนคเก็ต
  CRUISER // ครุยเซอร์
  TOURING // ทัวริ่ง
  ADVENTURE // แอดเวนเจอร์
  DIRT // วิบาก/ดิร์ท
  CAFE_RACER // คาเฟ่เรเซอร์
  UNDERBONE // รถครอบครัว/เวฟ
  CUB // มอเตอร์ไซค์ทรงคลาสสิค
}

// ประเภทการจดทะเบียน
enum RegistrationType {
  PERSONAL // บุคคลธรรมดา
  COMPANY // นิติบุคคล
}

// สภาพยานพาหนะ
enum Condition {
  EXCELLENT // ดีเยี่ยม
  GOOD // ดี
  FAIR // พอใช้
  POOR // ต้องซ่อม
}

// สถานะประกาศ
enum ListingStatus {
  DRAFT // แบบร่าง
  PENDING // รอตรวจสอบ
  ACTIVE // กำลังขาย
  INACTIVE // ไม่ใช้งาน
  SOLD // ขายแล้ว
  EXPIRED // หมดอายุ
  SUSPENDED // ถูกระงับ
  PAUSED // หยุดชั่วคราว (เกิน limit หลัง downgrade แพ็กเกจ — เวลานับเหลือจะถูก freeze ไว้)
}

// สถานะเล่มทะเบียน
enum RegistrationBookStatus {
  READY // พร้อมโอน
  FINANCED // ติดไฟแนนซ์
}

// ประเภทแก๊ส
enum GasType {
  NONE // ไม่ติดแก๊ส
  LPG // LPG
  NGV // NGV/CNG
}

// =============================================
// Package System - ระบบแพ็กเกจผู้ลงขาย
// =============================================

// Master Data แพ็กเกจ
model Package {
  id                  String   @id @default(cuid())
  name                String   @unique // e.g. Basic, Standard, Professional, Premium
  nameTh              String // ชื่อภาษาไทย
  slug                String   @unique // e.g. basic, standard, professional, premium
  description         String?  @db.Text
  targetAudience      String? // กลุ่มเป้าหมาย
  price               Decimal  @db.Decimal(10, 2) // ราคา/เดือน
  maxListings         Int // จำนวนประกาศสูงสุด (-1 = ไม่จำกัด)
  maxPhotosPerListing Int // จำนวนรูปสูงสุด/ประกาศ
  listingDurationDays Int // ระยะเวลาประกาศ (วัน), -1 = จนกว่าจะขายได้
  autoBumpPerDay      Int      @default(0) // จำนวนดันโพสต์อัตโนมัติ/วัน
  manualBumpPerDay    Int      @default(0) // จำนวนดันโพสต์ด้วยตัวเอง/วัน
  badge               String? // ป้ายพิเศษ เช่น Verified Seller, Hot Deal
  searchPriority      String   @default("normal") // normal, higher, top, priority
  features            Json     @default("[]") // Array ของฟีเจอร์เพิ่มเติม
  sortOrder           Int      @default(0) // ลำดับการแสดง
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  users        User[]               @relation("UserCurrentPackage")
  transactions PackageTransaction[]

  @@index([sortOrder])
  @@map("packages")
}

// สถานะการชำระเงิน
enum PaymentStatus {
  PENDING // รอตรวจสอบ
  APPROVED // อนุมัติแล้ว
  REJECTED // ถูกปฏิเสธ
}

// =============================================
// System Settings - ตั้งค่าระบบ (key-value store)
// =============================================
model SystemSetting {
  key       String   @id // e.g. "payment.bankName", "payment.accountNumber"
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// =============================================
// Storage Setting - ตั้งค่าผู้ให้บริการ Object Storage (singleton)
// =============================================
enum StorageProviderType {
  MINIO
  CLOUDFLARE_R2
}

model StorageSetting {
  id        String              @id @default(cuid())
  provider  StorageProviderType @default(MINIO)
  config    Json                @default("{}")
  updatedAt DateTime            @updatedAt
  updatedBy String?

  @@map("storage_settings")
}

model AdminSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("admin_settings")
}

// รายการอัพเกรด/ต่ออายุแพ็กเกจ
model PackageTransaction {
  id              String        @id @default(cuid())
  amount          Decimal       @db.Decimal(10, 2) // จำนวนเงินที่ต้องจ่าย
  slipImage       String // URL รูปสลิปการโอนเงิน
  status          PaymentStatus @default(PENDING)
  transactionType String        @default("UPGRADE") // "UPGRADE" | "RENEWAL"
  proratedCredit  Decimal?      @db.Decimal(10, 2) // เครดิตจากวันเหลือ (เฉพาะ UPGRADE)
  fromPackageName String? // ชื่อแพ็กเกจเดิม (snapshot ตอนสร้าง transaction)
  fromPackageSlug String? // slug แพ็กเกจเดิม
  adminNote       String? // หมายเหตุจาก admin (เหตุผลกรณีปฏิเสธ)
  reviewedAt      DateTime? // วันที่ตรวจสอบ
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
  @@map("package_transactions")
}

// รายการซื้อ slot ประกาศเพิ่ม (99 บาท/slot, สะสมถาวร)
model SlotPurchase {
  id           String        @id @default(cuid())
  quantity     Int
  pricePerSlot Decimal       @db.Decimal(10, 2)
  totalAmount  Decimal       @db.Decimal(10, 2)
  slipImage    String        @db.Text
  status       PaymentStatus @default(PENDING)
  adminNote    String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("slot_purchases")
}

// รายการต่ออายุประกาศ (Basic user จ่าย 50 บาท)
model ListingRenewal {
  id         String        @id @default(cuid())
  amount     Decimal       @db.Decimal(10, 2) // จำนวนเงิน (50 บาท)
  slipImage  String        @db.Text // base64 รูปสลิปการโอนเงิน
  status     PaymentStatus @default(PENDING)
  adminNote  String? // หมายเหตุจาก admin
  reviewedAt DateTime? // วันที่ตรวจสอบ
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   VehicleListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@map("listing_renewals")
}

// =============================================
// =============================================
// Garage System - โรงรถของฉัน
// =============================================

model GarageVehicle {
  id             String   @id @default(cuid())
  nickname       String   // ชื่อเรียกรถ
  brand          String
  model          String
  year           Int?
  color          String?
  licensePlate   String?
  currentMileage Int      @default(0)
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRecords ServiceRecord[]
  reminders      MaintenanceReminder[]

  @@index([userId])
  @@map("garage_vehicles")
}

model ServiceRecord {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  mileage     Int?
  cost        Decimal? @db.Decimal(10, 2)
  serviceDate DateTime
  shopName    String?
  createdAt   DateTime @default(now())

  vehicleId String
  vehicle   GarageVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, serviceDate])
  @@map("service_records")
}

model MaintenanceReminder {
  id          String    @id @default(cuid())
  title       String
  type        String    // DATE | MILEAGE
  dueDate     DateTime?
  dueMileage  Int?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  vehicleId String
  vehicle   GarageVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("maintenance_reminders")
}

// =============================================
// In-App Notification - แจ้งเตือนในระบบ
// =============================================

model UserNotification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   // PACKAGE_EXPIRING, PACKAGE_EXPIRED, PACKAGE_APPROVED, PACKAGE_REJECTED, LISTING_EXPIRED, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("user_notifications")
}

// Web Push Notification Subscription — ผูก browser endpoint กับ user
// ผู้ใช้คนหนึ่งมีได้หลาย subscription (หลาย browser/device)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text   // FCM / Mozilla / Apple endpoint URL
  p256dh    String   @db.Text            // ECDH public key (base64url)
  auth      String   @db.Text            // auth secret (base64url)
  userAgent String?  @db.Text            // for diagnostics / device management UI
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Bump/Boost System - ระบบดันโพส
// =============================================

model ListingBumpLog {
  id        String   @id @default(cuid())
  type      String   // "MANUAL" | "AUTO"
  createdAt DateTime @default(now())

  // Relations
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@map("listing_bump_logs")
}

// =============================================
// Notification System - ระบบแจ้งเตือน LINE
// =============================================

enum NotificationType {
  LISTING_EXPIRED     // ประกาศหมดอายุ
  LISTING_APPROVED    // ประกาศได้รับการอนุมัติ
  LISTING_REJECTED    // ประกาศถูกปฏิเสธ
  RENEWAL_APPROVED    // ต่ออายุได้รับการอนุมัติ
  SYSTEM_ANNOUNCEMENT // ประกาศจากระบบ
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  name      String           @unique // e.g. "listing_expired"
  label     String           // ชื่อแสดงผล e.g. "แจ้งเตือนประกาศหมดอายุ"
  type      NotificationType
  content   String           @db.Text // ข้อความ รองรับ {{userName}}, {{listingTitle}} etc.
  flexJson  String?          @db.Text // Flex Message JSON (optional)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  logs NotificationLog[]

  @@index([type])
  @@map("notification_templates")
}

// ─── Contact inbox — submissions from /contact form ────────────
model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phoneNumber String?
  subject     String
  message     String   @db.Text
  ipAddress   String?  // for rate-limit auditing / spam detection
  userAgent   String?  @db.Text

  // Triage
  status      String   @default("NEW")  // NEW | IN_PROGRESS | RESOLVED | SPAM
  isRead      Boolean  @default(false)
  adminNote   String?  @db.Text

  createdAt   DateTime @default(now())
  readAt      DateTime?
  resolvedAt  DateTime?
  resolvedBy  String?  // admin id

  @@index([status, createdAt])
  @@index([isRead])
  @@map("contact_messages")
}

// ─── Admin audit log — immutable record of every admin action ────
// Tracked actions: approve/reject listing, approve/reject package transaction,
// KYC approve/reject, delete/hide forum content, ban user, etc.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   // admin.id (not User)
  action     String   // LISTING_APPROVE, LISTING_REJECT, KYC_APPROVE, USER_BAN, etc.
  targetType String   // LISTING | USER | KYC | TRANSACTION | FORUM_POST | CONTACT | REPORT
  targetId   String
  note       String?  @db.Text
  metadata   Json?    // extra context (e.g. { reason: "...", previousStatus: "PENDING" })
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

// ─── Abuse reports — users flagging listings / posts / other users ────
model AbuseReport {
  id          String   @id @default(cuid())
  reporterId  String?  // FK to users; null = anonymous
  reporter    User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  targetType  String   // LISTING | FORUM_POST | FORUM_COMMENT | USER
  targetId    String   // id of the reported entity

  reason      String   // SPAM | FRAUD | INAPPROPRIATE | DUPLICATE | OTHER
  description String?  @db.Text

  status      String   @default("OPEN")  // OPEN | REVIEWING | RESOLVED | DISMISSED
  adminNote   String?  @db.Text

  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?  // admin id

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("abuse_reports")
}

model NotificationLog {
  id              String   @id @default(cuid())
  recipientType   String   // INDIVIDUAL, ALL_USERS, BY_PACKAGE, EXPIRED_LISTINGS
  recipientFilter String?  @db.Text // JSON: { packageSlug, userId, etc. }
  totalSent       Int      @default(0)
  totalFailed     Int      @default(0)
  sentBy          String   // admin ID
  createdAt       DateTime @default(now())

  // Relations
  templateId String
  template   NotificationTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
  @@index([createdAt])
  @@map("notification_logs")
}

// =============================================
// Service Enums
// =============================================

enum PartnerType {
  BANK
  INSURANCE
  INSPECTION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InquiryType {
  FINANCE
  INSURANCE
  DELIVERY
  TRANSFER
  GENERAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// =============================================
// Service System - ระบบบริการ
// =============================================

model ServicePartner {
  id          String      @id @default(cuid())
  name        String
  type        PartnerType
  logoUrl     String?
  description String?
  highlight   String?     // e.g. "ดอกเบี้ยพิเศษ", "อนุมัติไว 1 วัน"
  isActive    Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, isActive])
  @@map("service_partners")
}

model InspectionPackage {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  price         Decimal  @db.Decimal(10, 2)
  description   String?  @db.Text
  features      Json     @default("[]")
  isRecommended Boolean  @default(false)
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings InspectionBooking[]

  @@map("inspection_packages")
}

model InspectionBooking {
  id        String @id @default(cuid())
  packageId String
  package   InspectionPackage @relation(fields: [packageId], references: [id])
  userId    String?
  user      User?  @relation(fields: [userId], references: [id])

  // Vehicle info
  brandName   String
  modelName   String?
  vehicleNote String?

  // Appointment
  location        String
  appointmentDate DateTime
  timeSlot        String

  // Contact
  contactName  String
  contactPhone String
  contactLine  String?

  // Pricing
  subtotal Decimal @db.Decimal(10, 2)
  vat      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Status
  status    BookingStatus @default(PENDING)
  adminNote String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([appointmentDate])
  @@map("inspection_bookings")
}

model ServiceInquiry {
  id           String       @id @default(cuid())
  type         InquiryType
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  contactName  String
  contactPhone String
  contactLine  String?
  details      Json?
  status       InquiryStatus @default(NEW)
  adminNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type, status])
  @@index([userId])
  @@index([createdAt])
  @@map("service_inquiries")
}

// =============================================
// Forum / Community System - ระบบชุมชน
// =============================================

enum VoteType {
  UP
  DOWN
}

enum ForumPostStatus {
  PUBLISHED
  DRAFT
  REMOVED
}

// หมวดหมู่กระทู้
model ForumCategory {
  id       String  @id @default(cuid())
  name     String  @unique // เช่น "พูดคุยทั่วไป"
  slug     String  @unique // เช่น "general"
  icon     String? // phosphor icon name เช่น "ChatsCircle"
  color    String? // tailwind color เช่น "blue"
  order    Int     @default(0)
  isActive Boolean @default(true)

  posts ForumPost[]

  @@index([isActive, order])
  @@map("forum_categories")
}

// กระทู้
model ForumPost {
  id        String          @id @default(cuid())
  title     String
  content   String          @db.Text
  imageUrl  String?
  status    ForumPostStatus @default(PUBLISHED)
  isPinned  Boolean         @default(false)
  isSolved  Boolean         @default(false)
  viewCount Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String
  category   ForumCategory   @relation(fields: [categoryId], references: [id])
  listingId  String?
  listing    VehicleListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  comments ForumComment[]
  votes    ForumVote[]
  tags     ForumPostTag[]

  @@index([categoryId, createdAt])
  @@index([authorId])
  @@index([status, createdAt])
  @@index([listingId])
  @@map("forum_posts")
}

// ความเห็น / ตอบกระทู้
model ForumComment {
  id           String   @id @default(cuid())
  content      String   @db.Text
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  postId   String
  post     ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId String?
  parent   ForumComment?  @relation("Replies", fields: [parentId], references: [id])
  replies  ForumComment[] @relation("Replies")

  votes ForumCommentVote[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("forum_comments")
}

// โหวตกระทู้
model ForumVote {
  id     String    @id @default(cuid())
  type   VoteType
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("forum_votes")
}

// โหวตความเห็น
model ForumCommentVote {
  id        String       @id @default(cuid())
  type      VoteType
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("forum_comment_votes")
}

// แท็ก
model ForumTag {
  id    String       @id @default(cuid())
  name  String       @unique
  posts ForumPostTag[]

  @@map("forum_tags")
}

// many-to-many: post ↔ tag
model ForumPostTag {
  postId String
  tagId  String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    ForumTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("forum_post_tags")
}

// คะแนนชื่อเสียง สำหรับ Guru leaderboard
model UserReputation {
  id           String   @id @default(cuid())
  points       Int      @default(0)
  totalPosts   Int      @default(0)
  totalAnswers Int      @default(0)
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([points])
  @@map("user_reputations")
}
